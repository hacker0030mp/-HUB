RegisterConnection(RunService.RenderStepped:Connect(function()
    if not HubState.ESPEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = p.Character.HumanoidRootPart
            local hum = p.Character:FindFirstChild("Humanoid")
            if not hum or hum.Health <= 0 then
                if HubState.ESPObjects[p] then
                    HubState.ESPObjects[p].Text:Destroy()
                    HubState.ESPObjects[p] = nil
                end
                continue
            end
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.5, 0))
            if onScreen then
                if not HubState.ESPObjects[p] then
                    local text = Instance.new("TextLabel")
                    text.BackgroundTransparency = 1
                    text.Font = Enum.Font.GothamBold
                    text.Text = p.Name
                    text.TextColor3 
