local function CreateNewPage(pageName)
    local scrollingPage = Instance.new("ScrollingFrame")
    scrollingPage.Name = pageName
    scrollingPage.Position = UDim2.fromOffset(6, 6)
    scrollingPage.Size = UDim2.new(1, -12, 1, -12)
    scrollingPage.BackgroundTransparency = 1
    scrollingPage.ScrollBarThickness = 4
    scrollingPage.ScrollBarImageColor3 = THEME.Accent
    scrollingPage.CanvasSize = UDim2.new()
    scrollingPage.Visible = false
    scrollingPage.Parent = BodyContent

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.Padding = UDim.new(0, 8)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Parent = scrollingPage

    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollingPage.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 10)
    end)

    PagesRegistry[pageName] = scrollingPage
    return scrollingPage
end

local function AppendLabel(pageObj, textString, customHeight)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -8, 0, customHeight or 28)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.Text = textString
    label.TextColor3 = THEME.Muted
    label.TextSize = 12
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = pageObj
    return label
end

local function AppendButton(pageObj, buttonText, callbackFunc)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -8, 0, 35)
    button.BackgroundColor3 = THEME.Header
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamSemibold
    button.Text = buttonText
    button.TextColor3 = THEME.Text
    button.TextSize = 13
    button.Parent = pageObj
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)
    button.Activated:Connect(callbackFunc)
    return button
end

local function AppendToggle(pageObj, toggleLabel, initialState, callbackFunc)
    local currentState = initialState
    local btnRef
    local function UpdateVisual()
        btnRef.Text = toggleLabel .. " : " .. (currentState and "เปิดใช้งาน [ON]" or "ปิดใช้งาน [OFF]")
        btnRef.BackgroundColor3 = currentState and THEME.Accent or THEME.Header
    end
    btnRef = AppendButton(pageObj, "", function()
        currentState = not currentState
        UpdateVisual()
        callbackFunc(currentState)
    end)
    UpdateVisual()
    return btnRef
end

local function AppendInput(pageObj, inputLabel, defaultVal, minVal, maxVal, callbackFunc)
    local rowFrame = Instance.new("Frame")
    rowFrame.Size = UDim2.new(1, -8, 0, 42)
    rowFrame.BackgroundTransparency = 1
    rowFrame.Parent = pageObj

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.6, -4, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Gotham
    lbl.Text = inputLabel
    lbl.TextColor3 = THEME.Text
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = rowFrame

    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(0.4, -4, 0, 32)
    textBox.Position = UDim2.new(0.6, 4, 0, 5)
    textBox.BackgroundColor3 = THEME.Background
    textBox.BorderSizePixel = 0
    textBox.Font = Enum.Font.Gotham
    textBox.Text = tostring(defaultVal)
    textBox.PlaceholderText = tostring(minVal) .. " - " .. tostring(maxVal)
    textBox.TextColor3 = THEME.Text
    textBox.TextSize = 12
    textBox.ClearTextOnFocus = false
    textBox.Parent = rowFrame
    Instance.new("UICorner", textBox).CornerRadius = UDim.new(0, 6)

    textBox.FocusLost:Connect(function()
        local parsedNum = tonumber(textBox.Text)
        if not parsedNum then
            textBox.Text = tostring(defaultVal)
            return
        end
        parsedNum = math.clamp(parsedNum, minVal, maxVal)
        textBox.Text = tostring(parsedNum)
        callbackFunc(parsedNum)
    end)
    return textBox
end

local function AddTabButton(tabKey, displayTitle)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = tabKey .. "Tab"
    tabBtn.Size = UDim2.new(0, 105, 1, 0)
    tabBtn.BackgroundColor3 = THEME.Panel
    tabBtn.BorderSizePixel = 0
    tabBtn.Font = Enum.Font.GothamSemibold
    tabBtn.Text = displayTitle
    tabBtn.TextColor3 = THEME.Text
    tabBtn.TextSize = 12
    tabBtn.Parent = TabBarContainer
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 7)

    local pageRef = CreateNewPage(tabKey)
    TabButtonsRegistry[tabKey] = tabBtn

    tabBtn.Activated:Connect(function()
        for k, p in pairs(PagesRegistry) do
            p.Visible = (k == tabKey)
        end
        for k, b in pairs(TabButtonsRegistry) do
            b.BackgroundColor3 = (k == tabKey) and THEME.Accent or THEME.Panel
        end
    end)
    return pageRef
end

