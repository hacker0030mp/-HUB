local function ShowNotification(titleText, messageText, duration)
    task.spawn(function()
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, 0, 0, 65)
        card.BackgroundColor3 = THEME.Background
        card.BorderColor3 = THEME.Accent
        card.BorderSizePixel = 1
        card.BackgroundTransparency = 0.1
        card.Parent = NotificationContainer
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, -15, 0, 22)
        title.Position = UDim2.fromOffset(10, 5)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBold
        title.Text = titleText
        title.TextColor3 = THEME.AccentLight
        title.TextSize = 13
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = card

        local msg = Instance.new("TextLabel")
        msg.Size = UDim2.new(1, -15, 0, 30)
        msg.Position = UDim2.fromOffset(10, 27)
        msg.BackgroundTransparency = 1
        msg.Font = Enum.Font.Gotham
        msg.Text = messageText
        msg.TextColor3 = THEME.Text
        msg.TextSize = 11
        msg.TextWrapped = true
        msg.TextXAlignment = Enum.TextXAlignment.Left
        msg.Parent = card

        task.wait(duration or 3)
        TweenService:Create(card, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
        task.wait(0.4)
        card:Destroy()
    end)
end

