createSectionTitle("⚔️ ระบบ Kill (การกำจัดเป้าหมาย)")

createButton("💥 วาร์ปไปฟัน/ฆ่าผู้เล่นทุกคนในแมพ (Kill All)", function()
    pcall(function()
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local originalPos = myRoot.CFrame

        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local targetRoot = plr.Character.HumanoidRootPart
                myRoot.CFrame = targetRoot.CFrame
                task.wait(0.15)
            end
        end
        myRoot.CFrame = originalPos
    end)
end)

createToggle("🎯 ล็อกเป้าหมายโจมตีอัตโนมัติ (Kill Aura)", false, function(state)
    _G.KillAura = state
    task.spawn(function()
        while _G.KillAura do
            task.wait(0.3)
            pcall(function()
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not myRoot then return end
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                        local enemyRoot = plr.Character.HumanoidRootPart
                        if (myRoot.Position - enemyRoot.Position).Magnitude < 18 then
                            local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                            if tool then tool:Activate() end
                        end
                    end
                end
            end)
        end
    end)
end)

