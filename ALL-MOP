-- ฟังก์ชันเปิดหน้าต่างเมนูหลักหลังจากผ่านคีย์
local function OpenMainHub()
    KeyFrame:Destroy()

    -- =======================================================
    -- 2. ไอคอนลูกบอลหยินหยางลอยได้ (Floating Rotating Logo)
    -- =======================================================
    local FloatingButton = Instance.new("ImageButton")
    FloatingButton.Name = "FloatingLogo"
    FloatingButton.Parent = ScreenGui
    FloatingButton.BackgroundColor3 = Color3.fromRGB(5, 14, 9)
    FloatingButton.BorderColor3 = Color3.fromRGB(16, 185, 129)
    FloatingButton.BorderSizePixel = 2
    FloatingButton.Position = UDim2.new(0.05, 0, 0.2, 0)
    FloatingButton.Size = UDim2.new(0, 65, 0, 65)
    FloatingButton.Image = "https://cdn.phototourl.com/member/2026-10-16-c8fd00c7-3c45-446d-bf02-956f9ca17068.jpg"
    FloatingButton.ScaleType = Enum.ScaleType.Stretch
    FloatingButton.Active = true
    FloatingButton.Draggable = true -- ลากบนจอมือถือได้

    Instance.new("UICorner", FloatingButton).CornerRadius = UDim.new(1, 0)

    -- หมุน 360 องศาตลอดเวลา
    task.spawn(function()
        local rot = 0
        while FloatingButton and FloatingButton.Parent do
            rot = (rot + 3) % 360
            FloatingButton.Rotation = rot
            task.wait(0.04)
        end
    end)

    -- =======================================================
    -- 3. หน้าต่างเมนูหลัก (Main Frame)
    -- =======================================================
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(5, 14, 9)
    MainFrame.BorderColor3 = Color3.fromRGB(16, 185, 129)
    MainFrame.BorderSizePixel = 2
    MainFrame.Position = UDim2.new(0.5, -225, 0.5, -170)
    MainFrame.Size = UDim2.new(0, 450, 0, 360)
    MainFrame.Visible = false
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)

    -- หัวข้อค่ายผู้พัฒนา
    local Header = Instance.new("Frame")
    Header.Parent = MainFrame
    Header.BackgroundColor3 = Color3.fromRGB(4, 120, 87)
    Header.Size = UDim2.new(1, 0, 0, 40)
    Instance.new("UICorner", Header).CornerRadius = UDim.new(0, 12)

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Parent = Header
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Size = UDim2.new(1, -45, 1, 0)
    TitleLabel.Position = UDim2.new(0, 12, 0, 0)
    TitleLabel.Font = Enum.Font.SourceSansBold
    TitleLabel.Text = "สุริยันหยินหยาง HUB & RTS HUB | โมโก้ ไมเกิร์น & ใจ"
    TitleLabel.TextColor3 = Color3.fromRGB(236, 253, 245)
    TitleLabel.TextSize = 12
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    -- ปุ่มปิด (X)
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Parent = Header
    CloseBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38)
    CloseBtn.Position = UDim2.new(1, -35, 0.5, -12)
    CloseBtn.Size = UDim2.new(0, 24, 0, 24)
    CloseBtn.Font = Enum.Font.SourceSansBold
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseBtn.TextSize = 14
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)

    CloseBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
    end)

    FloatingButton.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
    end)

    -- เนื้อหาเมนู (ScrollingFrame)
    local Content = Instance.new("ScrollingFrame")
    Content.Parent = MainFrame
    Content.BackgroundTransparency = 1
    Content.Position = UDim2.new(0, 10, 0, 50)
    Content.Size = UDim2.new(1, -20, 1, -60)
    Content.CanvasSize = UDim2.new(0, 0, 2, 0)
    Content.ScrollBarThickness = 5

    local UIList = Instance.new("UIListLayout", Content)
    UIList.Padding = UDim.new(0, 8)

    local function AddBtn(text, cb)
        local btn = Instance.new("TextButton")
        btn.Parent = Content
        btn.BackgroundColor3 = Color3.fromRGB(4, 120, 87)
        btn.Size = UDim2.new(1, 0, 0, 38)
        btn.Font = Enum.Font.SourceSansBold
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(236, 253, 245)
        btn.TextSize = 14
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
        btn.MouseButton1Click:Connect(cb)
    end

    -- ฟังก์ชัน Kill & Utility
    AddBtn("💥 วาร์ปฆ่าผู้เล่นทุกคนในแมพ (Kill All)", function()
        pcall(function()
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myRoot then return end
            local pos = myRoot.CFrame
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    myRoot.CFrame = p.Character.HumanoidRootPart.CFrame
                    task.wait(0.1)
                end
            end
            myRoot.CFrame = pos
        end)
    end)

    AddBtn("⚡ เร่งความเร็วเดิน (WalkSpeed 50)", function()
        pcall(function() LocalPlayer.Character.Humanoid.WalkSpeed = 50 end)
    end)

    AddBtn("🚀 กระโดดสูงพิเศษ (JumpPower 120)", function()
        pcall(function()
            LocalPlayer.Character.Humanoid.UseJumpPower = true
            LocalPlayer.Character.Humanoid.JumpPower = 120
        end)
    end)

    AddBtn("🔒 ล็อก/ปลดล็อกไอคอนลอย", function()
        FloatingButton.Draggable = not FloatingButton.Draggable
    end)

    AddBtn("❌ ปิดสคริปต์ทั้งหมด", function()
        ScreenGui:Destroy()
    end)
end

