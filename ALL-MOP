        SubmitBtn.Text = "คีย์ถูกต้อง! กำลังเข้าสู่ระบบ..."
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(4, 120, 87)
        task.wait(1)
        OpenMainHub()
    else
        SubmitBtn.Text = "คีย์ไม่ถูกต้อง! ลองใหม่อีกครั้ง"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38)
        task.wait(1.5)
        SubmitBtn.Text = "ยืนยันและเข้าสู่ระบบ"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(16, 185, 129)
    end
end)
