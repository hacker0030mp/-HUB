-- 🌀 ปุ่ม Floating Icon (Econ 1)
-- =================================================================
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

if CoreGui:FindFirstChild("EvadeToggleGui") then CoreGui.EvadeToggleGui:Destroy() end

local ToggleGui = Instance.new("ScreenGui")
ToggleGui.Name = "EvadeToggleGui"
ToggleGui.Parent = CoreGui

local ToggleButton = Instance.new("ImageButton")
ToggleButton.Name = "Econ1_Button"
ToggleButton.Size = UDim2.fromOffset(55, 55)
ToggleButton.Position = UDim2.new(0.1, 0, 0.2, 0)
ToggleButton.Image = MainImageURL
ToggleButton.BackgroundTransparency = 1
ToggleButton.Parent = ToggleGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(1, 0)
UICorner.Parent = ToggleButton

task.spawn(function()
    while ToggleButton and ToggleButton.Parent do
        ToggleButton.Rotation = 0
        local tween = TweenService:Create(ToggleButton, TweenInfo.new(3, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), { Rotation = 360 })
        tween:Play()
        tween.Completed:Wait()
    end
end)

local dragging = false
local dragInput, dragStart, startPos
local dragMoved = false

local function updateInput(input)
    local delta = input.Position - dragStart
    ToggleButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragMoved = false
        dragStart = input.Position
        startPos = ToggleButton.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)

ToggleButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        if (input.Position - dragStart).Magnitude > 5 then dragMoved = true end
        updateInput(input)
    end
end)

ToggleButton.MouseButton1Click:Connect(function()
    if not dragMoved then PopupGui.Enabled = not PopupGui.Enabled end
end)

