local isAutoCollectActive = false
local collectRadius = 50

CollectSection:Toggle({
    Title = "เปิด/ปิด ระบบดูดไอเทมอัตโนมัติ",
    Value = false,
    Callback = function(state)
        isAutoCollectActive = state
