                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Downed") then
                        -- ส่งสัญญาณชุบชีวิตเพื่อนที่ล้มเพื่อรับเงินบัฟ
                        if events:FindFirstChild("Revive") then
                            events.Revive:FireServer(p.Character)
                        end
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

