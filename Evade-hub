-- ลูปการทำงาน: ฟาร์ม Token แบบวาร์ปลงไปเก็บทั่วแมพ แล้วกลับขึ้นฐาน 100m
task.spawn(function()
    while true do
        if _G.AutoTokenFarm then
            pcall(function()
                CreateSafePlatform()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local foundToken = false

                    -- สแกนหา Token / Ticket ทั่วทั้งแมพโดยไม่มีจำกัดระยะ
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and (obj.Name:lower():find("token") or obj.Name:lower():find("ticket") or obj.Name:lower():find("collect")) then
                            foundToken = true
                            -- วาร์ปลงไปเก็บ Token
                            hrp.CFrame = obj.CFrame
                            task.wait(0.15)
                        end
                    end

                    -- เมื่อเก็บเสร็จ หรือสแกนรอบแมพเรียบร้อย ให้วาร์ปกลับขึ้นแท่นหยินหยาง 100m
                    if safePlatformPart then
                        hrp.CFrame = safePlatformPart.CFrame + Vector3.new(0, 4, 0)
                    end
                end
            end)
        end
        task.wait(0.5)
    end
end)

-- ลูปการทำงาน: ฟาร์มเงินแบบ Auto Revive / Fast Respawn Loop
task.spawn(function()
    while true do
        if _G.AutoMoneyFarm then
            pcall(function()
                -- ยิงอีเวนต์ชุบชีวิตเพื่อนหรือตัวเองเมื่อล้มใน Evade
                local events = game:GetService("ReplicatedStorage"):FindFirstChild("Events") or game:GetService("ReplicatedStorage")
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Downed") then
                        -- ส่งสัญญาณชุบชีวิตเพื่อนที่ล้มเพื่อรับเงินบัฟ
                        if events:FindFirstChild("Revive") then
                            events.Revive:FireServer(p.Character)
                        end
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

