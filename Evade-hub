local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ลูปปรับค่าความเร็ว และ Auto Jump
task.spawn(function()
    while task.wait(0.1) do
        if _G.EnablePlayerCustoms and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            if _G.CustomSpeed then
                LocalPlayer.Character.Humanoid.WalkSpeed = _G.CustomSpeed
            end
            if _G.AutoJump and LocalPlayer.Character.Humanoid.FloorMaterial ~= Enum.Material.Air then
                LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

-- ลูประบบ Bot ESP
task.spawn(function()
    while task.wait(1) do
        if _G.BotESP then
            for _, obj in pairs(workspace:GetChildren()) do
                if obj:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                    if not obj:FindFirstChild("BotHighlight") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "BotHighlight"
                        hl.FillColor = Color3.fromRGB(200, 200, 200)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.Parent = obj
                    end
                end
            end
        else
            for _, obj in pairs(workspace:GetChildren()) do
                if obj:FindFirstChild("BotHighlight") then
                    obj.BotHighlight:Destroy()
                end
            end
        end
    end
end)
