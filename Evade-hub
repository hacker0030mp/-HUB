-- ลูปการทำงานเรียลไทม์ของ ESP
task.spawn(function()
    while true do
        if _G.NextbotESP then
            for _, obj in ipairs(Workspace:GetChildren()) do
                if obj:IsA("Model") and obj ~= LocalPlayer.Character then
                    local humanoid = obj:FindFirstChildOfClass("Humanoid")
                    local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                    if humanoid and rootPart and not Players:GetPlayerFromCharacter(obj) then
                        if not obj:FindFirstChild("Evade_Highlight") then
                            local hl = Instance.new("Highlight")
                            hl.Name = "Evade_Highlight"
                            hl.FillColor = Color3.fromRGB(255, 50, 50)
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.Parent = obj
                        end
                        if not obj:FindFirstChild("Evade_Tag") then
                            local bb = Instance.new("BillboardGui")
                            bb.Name = "Evade_Tag"
                            bb.Size = UDim2.new(0, 160, 0, 40)
                            bb.StudsOffset = Vector3.new(0, 3, 0)
                            bb.AlwaysOnTop = true
                            bb.Parent = obj
                            local lbl = Instance.new("TextLabel")
                            lbl.Name = "Txt"
                            lbl.Size = UDim2.new(1, 0, 1, 0)
                            lbl.BackgroundTransparency = 1
                            lbl.TextColor3 = Color3.fromRGB(255, 255, 0)
                            lbl.TextSize = 13
                            lbl.Font = Enum.Font.SourceSansBold
                            lbl.Parent = bb
                        end
                        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if myRoot and obj:FindFirstChild("Evade_Tag") then
                            local dist = math.floor((rootPart.Position - myRoot.Position).Magnitude)
                            local label = obj.Evade_Tag:FindFirstChild("Txt")
                            if label then label.Text = "🚨 " .. obj.Name .. "\n[" .. dist .. "m]" end
                        end
                    end
                end
            end
        else
            for _, obj in ipairs(Workspace:GetChildren()) do
                if obj:FindFirstChild("Evade_Highlight") then obj.Evade_Highlight:Destroy() end
                if obj:FindFirstChild("Evade_Tag") then obj.Evade_Tag:Destroy() end
            end
        end
        task.wait(0.3)
    end
end)

