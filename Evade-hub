    Value = { Min = 1, Max = 200, Default = 50 },
    Callback = function(value) collectRadius = value end
})

task.spawn(function()
    while true do
        if isAutoCollectActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and (obj.Name:lower():find("item") or obj.Name:lower():find("coin") or obj.Name:lower():find("drop") or obj.Name:lower():find("ore")) then
                            local dist = (hrp.Position - obj.Position).Magnitude
                            if dist <= collectRadius then
                                obj.CFrame = hrp.CFrame
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.2)
    end
end)

