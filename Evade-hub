-- ลูปหลักประมวลผล Aimbot, TriggerBot, ความเร็ว, กระโดด, บิน, ล่องหน
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
        local humanoid = char.Humanoid
        local rootPart = char.HumanoidRootPart

        -- 1. จัดการวิ่งเร็ว
        if speedEnabled then
            humanoid.WalkSpeed = speedValue
        else
            humanoid.WalkSpeed = 16 -- ค่าปกติ
        end

        -- 2. จัดการกระโดดสูง
        if jumpEnabled then
            humanoid.JumpPower = jumpValue * 3 -- ปรับสเกลให้กระโดดได้สูงตามสไลด์
            humanoid.UseJumpPower = true
        else
            humanoid.JumpPower = 50 -- ค่าปกติ
        end

        -- 3. จัดการระบบบิน
        if flyEnabled then
            local camera = workspace.CurrentCamera
            rootPart.Velocity = Vector3.new(0, 0, 0)
            local moveDir = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.RightVector end
            rootPart.CFrame = rootPart.CFrame + (moveDir * (flySpeed / 5))
        end

        -- 4. จัดการระบบล่องหน (ปรับความโปร่งใสเป็นอากาศ)
        local transparency = invisValue / 100
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                if invisEnabled then
                    part.Transparency = transparency
                else
                    part.Transparency = 0
                end
            elseif part:IsA("Accessory") then
                local handle = part:FindFirstChild("Handle")
                if handle then
                    if invisEnabled then
                        handle.Transparency = transparency
                    else
                        handle.Transparency = 0
                    end
                end
            end
        end
    end

    -- Aimbot Logic
    if aimbotEnabled then
        local target = nil
        local minDist = math.huge
        local mousePos = UserInputService:GetMouseLocation()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                if not teamCheckEnabled or p.Team ~= LocalPlayer.Team then
                    local head = p.Character.Head
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < aimbotFOV and dist < minDist then
                            minDist = dist
                            target = head
                        end
                    end
                end
            end
        end
        if target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end

    -- TriggerBot Logic
    if triggerBotEnabled then
        local mouse = LocalPlayer:GetMouse()
        local target = mouse.Target
        if target and target.Parent then
            local enemy = Players:GetPlayerFromCharacter(target.Parent)
            if enemy and enemy ~= LocalPlayer then
                if not teamCheckEnabled or enemy.Team ~= LocalPlayer.Team then
                    pcall(function()
                        mouse1press()
                        task.wait(0.02)
                        mouse1release()
                    end)
                end
            end
        end
    end
end)

