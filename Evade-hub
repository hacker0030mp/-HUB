-- 🌀 ปุ่ม Floating Icon (Econ 1)
-- =================================================================
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

if CoreGui:FindFirstChild("EvadeToggleGui") then CoreGui.EvadeToggleGui:Destroy() end

local ToggleGui = Instance.new("ScreenGui")
ToggleGui.Name = "EvadeToggleGui"
ToggleGui.Parent = CoreGui

local ToggleButton = Instance.new("ImageButton")
ToggleButton.Size = UDim2.fromOffset(55, 55)
ToggleButton.Position = UDim2.new(0.1, 0, 0.2, 0)
ToggleButton.Image = MainImageURL
ToggleButton.BackgroundTransparency = 1
ToggleButton.Parent = ToggleGui
Instance.new("UICorner", ToggleButton).CornerRadius = UDim.new(1, 0)

task.spawn(function()
    while ToggleButton and ToggleButton.Parent do
        ToggleButton.Rotation = 0
        local tween = TweenService:Create(ToggleButton, TweenInfo.new(3, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), { Rotation = 360 })
        tween:Play()
        tween.Completed:Wait()
    end
end)

local dragging = false
local dragStart, startPos, dragMoved = nil, nil, false

ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragMoved = false
        dragStart = input.Position
        startPos = ToggleButton.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging then
        local delta = input.Position - dragStart
        if delta.Magnitude > 5 then dragMoved = true end
        ToggleButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

ToggleButton.MouseButton1Click:Connect(function()
    if not dragMoved then PopupGui.Enabled = not PopupGui.Enabled end
end)

-- =================================================================
-- 🎯 ระบบ ETP Engine
-- =================================================================
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

if CoreGui:FindFirstChild("ETP_RenderGui") then CoreGui.ETP_RenderGui:Destroy() end
local ETP_Gui = Instance.new("ScreenGui")
ETP_Gui.Name = "ETP_RenderGui"
ETP_Gui.Parent = CoreGui

RunService.RenderStepped:Connect(function()
    if not _G.EnableETP then
        ETP_Gui:ClearAllChildren()
        return
    end

    for _, obj in pairs(workspace:GetChildren()) do
        local humanoidRootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
        if humanoidRootPart and obj ~= LocalPlayer.Character then
            local pos, onScreen = Camera:WorldToViewportPoint(humanoidRootPart.Position)
            if onScreen then
                local dist = math.floor((humanoidRootPart.Position - Camera.CFrame.Position).Magnitude)
                
                local nameTag = ETP_Gui:FindFirstChild(obj.Name .. "_Tag") or Instance.new("TextLabel")
                nameTag.Name = obj.Name .. "_Tag"
                nameTag.Size = UDim2.fromOffset(150, 30)
                nameTag.Position = UDim2.new(0, pos.X - 75, 0, pos.Y - 40)
                nameTag.BackgroundTransparency = 1
                nameTag.TextColor3 = Color3.fromRGB(255, 255, 255)
                nameTag.TextSize = 12
                nameTag.Font = Enum.Font.SourceSansBold
                nameTag.Text = obj.Name .. " [" .. dist .. "m]"
                nameTag.Parent = ETP_Gui

                if _G.ETP_Tracers then
                    local tracer = ETP_Gui:FindFirstChild(obj.Name .. "_Line") or Instance.new("Frame")
                    tracer.Name = obj.Name .. "_Line"
                    tracer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    tracer.BorderSizePixel = 0
                    tracer.Parent = ETP_Gui

                    local screenCenterBottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    local targetPos = Vector2.new(pos.X, pos.Y)
                    local distance = (targetPos - screenCenterBottom).Magnitude
                    tracer.Size = UDim2.fromOffset(2, distance)
                    tracer.Position = UDim2.fromOffset(screenCenterBottom.X, screenCenterBottom.Y)
                    tracer.Rotation = math.deg(math.atan2(targetPos.Y - screenCenterBottom.Y, targetPos.X - screenCenterBottom.X)) - 90
                else
                    local tracer = ETP_Gui:FindFirstChild(obj.Name .. "_Line")
                    if tracer then tracer:Destroy() end
                end
            else
                local nameTag = ETP_Gui:FindFirstChild(obj.Name .. "_Tag")
                if nameTag then nameTag:Destroy() end
                local tracer = ETP_Gui:FindFirstChild(obj.Name .. "_Line")
                if tracer then tracer:Destroy() end
            end
        end
    end
end)

