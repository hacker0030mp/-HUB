local SafePlatformSection = TabFarm:Section({
    Title = "☯️ จุดพักปลอดภัย (Yin-Yang Safe Platform 100m)",
    Box = true, BoxBorder = true, Opened = true
})

local safePlatformPart = nil
local function CreateSafePlatform()
    if not safePlatformPart or not safePlatformPart.Parent then
        safePlatformPart = Instance.new("Part")
        safePlatformPart.Name = "RTS_YinYang_Platform"
        safePlatformPart.Size = Vector3.new(25, 2, 25)
        safePlatformPart.Position = Vector3.new(0, 100, 0) -- สูงจากพื้น 100 เมตร
        safePlatformPart.Anchored = true
        safePlatformPart.CanCollide = true
        safePlatformPart.Color = Color3.fromRGB(20, 20, 20)
        safePlatformPart.Material = Enum.Material.SmoothPlastic
        safePlatformPart.Parent = Workspace

        -- ตกแต่งพื้นผิวรูป Yin-Yang (หรือใช้ Decal)
        local decal = Instance.new("Decal")
        decal.Texture = "rbxassetid://1085002030" -- รูปทรงหยินหยาง
        decal.Face = Enum.NormalId.Top
        decal.Parent = safePlatformPart
    end
end

SafePlatformSection:Button({
    Title = "☯️ วาร์ปขึ้นไปยังจุดพักหยินหยาง (100 เมตร)",
    Callback = function()
        CreateSafePlatform()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
